@{
	ViewData["Title"] = "Usuarios";
	ViewData["Description"] = "Organiza y crea usuarios para ingreso al sistema";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-body py-3">
	<div class="row align-items-center">
		<div class="col-12">
			<div class="d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="card-title">Usuarios</h4>
					<p>Organiza y crea usuarios para el ingreso al sistema</p>
				</div>
				<button class="btn btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalCrearUsuario">
					<i class="ti ti-plus fs-5"></i>
					Nuevo usuario
				</button>
			</div>
		</div>
	</div>
</div>

<div class="card card-body">
	<div class="row mb-3">
		<div class="col">
			<label class="form-label">Usuario</label>
			<div class="input-group">
				<input id="txtBuscarUsuario" class="form-control" placeholder="Buscar usuarios..." />
				<button id="btnLimpiarFiltros" class="btn btn-outline-secondary"><i class="ti ti-eraser fs-5"></i></button>
			</div>

		</div>
		<div class="col">
			<label class="form-label">Estado</label>
			<select id="slcEstado" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Activo</option>
				<option value="2">Inactivo</option>
			</select>
		</div>
	</div>

	<div id="tblUsuarios" class="table-striped">

	</div>
</div>


<!-- MODAL CREAR USUARIO -->
<div class="modal fade" id="modalCrearUsuario" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Crear usuario
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div class="row">
					<!-- Nombre -->
					<div class="col-md-6 mb-3">
						<label for="txtNombre" class="form-label">
							Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNombre" class="form-control" placeholder="Ej: Lorena" maxlength="50" required />
					</div>

					<!-- Apellido -->
					<div class="col-md-6 mb-3">
						<label for="txtApellido" class="form-label">
							Apellido <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtApellido" class="form-control" placeholder="Ej: Torres" maxlength="50" required />
					</div>

					<!-- Usuario -->
					<div class="col-md-6 mb-3">
						<label for="txtUsuario" class="form-label">
							Usuario <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtUsuario" class="form-control" placeholder="Se genera automáticamente" maxlength="50" required />
					</div>

					<!-- Contraseña -->
					<div class="col-md-6 mb-3">
						<label for="txtContrasena" class="form-label">
							Contraseña <span class="text-danger">*</span>
						</label>
						<div class="input-group">
							<input type="password" id="txtContrasena" class="form-control" placeholder="*******" />
							<button id="btnVerContrasena" class="btn btn-outline-secondary"><i class="ti ti-eye fs-5"></i></button>
						</div>
					</div>

					<!-- Rol -->
					<div class="col-md-6 mb-3">
						<label class="form-label">
							Rol <span class="text-danger">*</span>
						</label>
						<select id="slcRol" class="form-select">
							<option value="0">Ninguna</option>
						</select>
					</div>

					<div class="col-md-6 mb-3">
						<label for="slcPerfil" class="form-label">Perfil <span class="text-danger">*</span></label>
						<select id="slcPerfil" class="form-select">
							<option value="0">Selecciona primero un rol</option>
						</select>
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivo" class="form-check-input" checked />
							<label for="chkActivo" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si el usuario estará habilitado para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnGuardarUsuario" class="btn bg-primary-subtle text-primary">
						Guardar usuario
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- MODAL EDITAR USUARIO -->
<div class="modal fade" id="modalEditarUsuario" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Editar usuario
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<input type="hidden" id="txtIdUsuarioEditar" />
				<div class="row">
					<!-- Nombre -->
					<div class="col-md-6 mb-3">
						<label for="txtNombreEditar" class="form-label">
							Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNombreEditar" class="form-control" placeholder="Ej: Lorena" maxlength="50" required />
					</div>

					<!-- Apellido -->
					<div class="col-md-6 mb-3">
						<label for="txtApellidoEditar" class="form-label">
							Apellido <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtApellidoEditar" class="form-control" placeholder="Ej: Torres" maxlength="50" required />
					</div>

					<!-- Usuario -->
					<div class="col-md-6 mb-3">
						<label for="txtUsuarioEditar" class="form-label">
							Usuario <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtUsuarioEditar" class="form-control" placeholder="Se genera automáticamente" maxlength="50" required />
					</div>

					<!-- Contraseña -->
					<div class="col-md-6 mb-3">
						<label for="txtContrasenaEditar" class="form-label">
							Contraseña <span class="text-danger">*</span>
						</label>
						<div class="input-group">
							<input type="password" id="txtContrasenaEditar" class="form-control" placeholder="*******" />
							<button id="btnVerContrasena" class="btn btn-outline-secondary"><i class="ti ti-eye fs-5"></i></button>
						</div>
					</div>

					<!-- Rol -->
					<div class="col-md-6 mb-3">
						<label class="form-label">
							Rol <span class="text-danger">*</span>
						</label>
						<select id="slcRolEditar" class="form-select">
							<option value="0">Ninguna</option>
						</select>
					</div>

					<div class="col-md-6 mb-3">
						<label for="slcPerfilEditar" class="form-label">Perfil <span class="text-danger">*</span></label>
						<select id="slcPerfilEditar" class="form-select">
							<option value="0">Selecciona primero un rol</option>
						</select>
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivoEditar" class="form-check-input" checked />
							<label for="chkActivoEditar" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si el usuario estará habilitado para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnActualizarUsuario" class="btn bg-primary-subtle text-primary">
						Actualizar usuario
					</button>
				</div>
			</div>
		</div>
	</div>
</div>


@section Scripts{
	<script src="~/js/modules/seguridad/usuarios/usuario-index.js" asp-append-version="true"></script>
	<script src="~/js/modules/seguridad/usuarios/usuario-form.js" asp-append-version="true"></script>
}
