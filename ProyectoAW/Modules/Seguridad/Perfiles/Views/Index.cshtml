@{
	ViewData["Title"] = "Perfiles";
	ViewData["Description"] = "Organiza y crea los perfiles para los usuarios";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-body py-3">
	<div class="row align-items-center">
		<div class="col-12">
			<div class="d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="card-title">Perfiles</h4>
					<p>Organiza y crea los perfiles correspondientes a cada usuario</p>
				</div>
				<button class="btn btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalCrearPerfil">
					<i class="ti ti-plus fs-5"></i>
					Nuevo perfil
				</button>
			</div>
		</div>
	</div>
</div>

<div class="card card-body">
	<div class="row mb-3">
		<div class="col">
			<label class="form-label">Perfil</label>
			<div class="input-group">
				<input id="txtBuscarPerfil" class="form-control" placeholder="Buscar perfil..." />
				<button id="btnLimpiarFiltros" class="btn btn-outline-secondary"><i class="ti ti-eraser fs-5"></i></button>
			</div>
		</div>
		<div class="col">
			<label class="form-label">Estado</label>
			<select id="slcEstado" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Activo</option>
				<option value="2">Inactivo</option>
			</select>
		</div>
	</div>

	<div id="tblPerfiles" class="table-striped"></div>
</div>


<!-- MODAL CREAR PERFIL -->
<div class="modal fade" id="modalCrearPerfil" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-xl">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">Crear perfil</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div class="row">
					<div class="col-md-6 mb-3">
						<label for="txtNombre" class="form-label">Nombre <span class="text-danger">*</span></label>
						<input type="text" id="txtNombre" class="form-control" placeholder="Ej: Almacenero" maxlength="100" required />
					</div>

					<div class="col-md-6 mb-3">
						<label for="slcRol" class="form-label">Rol <span class="text-danger">*</span></label>
						<select id="slcRol" class="form-select">
							<option value="0">Seleccione un rol</option>
						</select>
					</div>

					<div class="col-12">
						<label class="form-label">Permisos por módulo</label>
						<div class="table-responsive border rounded">
							<table class="table table-bordered align-middle text-center mb-0 tabla-permisos">
								<thead class="table-light">
									<tr>
										<th class="text-start">Módulo</th>
										<th>Ver <br /><input type="checkbox" class="form-check-input chk-columna" data-permiso="ver" title="Marcar toda la columna" /></th>
										<th>Crear <br /><input type="checkbox" class="form-check-input chk-columna" data-permiso="crear" title="Marcar toda la columna" /></th>
										<th>Actualizar <br /><input type="checkbox" class="form-check-input chk-columna" data-permiso="actualizar" title="Marcar toda la columna" /></th>
										<th>Eliminar <br /><input type="checkbox" class="form-check-input chk-columna" data-permiso="eliminar" title="Marcar toda la columna" /></th>
									</tr>
								</thead>
								<tbody id="tbodyPermisos">
									<tr><td colspan="5" class="text-muted py-3">Selecciona un rol para ver los módulos disponibles.</td></tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnGuardarPerfil" class="btn bg-primary-subtle text-primary">
						Guardar perfil
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- MODAL EDITAR PERFIL -->
<div class="modal fade" id="modalEditarPerfil" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-xl">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">Editar perfil</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<input type="hidden" id="txtIdPerfilEditar" />
				<div class="row">
					<div class="col-md-6 mb-3">
						<label for="txtNombreEditar" class="form-label">Nombre <span class="text-danger">*</span></label>
						<input type="text" id="txtNombreEditar" class="form-control" maxlength="100" required />
					</div>

					<div class="col-md-6 mb-3">
						<label for="slcRolEditar" class="form-label">Rol <span class="text-danger">*</span></label>
						<select id="slcRolEditar" class="form-select">
							<option value="0">Seleccione un rol</option>
						</select>
					</div>

					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivoEditar" class="form-check-input" checked />
							<label for="chkActivoEditar" class="form-check-label">Activo</label>
						</div>
						<small class="text-muted">Indica si el perfil estará habilitado para asignarse a usuarios</small>
					</div>

					<div class="col-12">
						<label class="form-label">Permisos por módulo</label>
						<div class="table-responsive border rounded">
							<table class="table table-bordered align-middle text-center mb-0 tabla-permisos">
								<thead class="table-light">
									<tr>
										<th class="text-start">Módulo</th>
										<th>Ver <br /><input type="checkbox" class="form-check-input chk-columna" data-permiso="ver" title="Marcar toda la columna" /></th>
										<th>Crear <br /><input type="checkbox" class="form-check-input chk-columna" data-permiso="crear" title="Marcar toda la columna" /></th>
										<th>Actualizar <br /><input type="checkbox" class="form-check-input chk-columna" data-permiso="actualizar" title="Marcar toda la columna" /></th>
										<th>Eliminar <br /><input type="checkbox" class="form-check-input chk-columna" data-permiso="eliminar" title="Marcar toda la columna" /></th>
									</tr>
								</thead>
								<tbody id="tbodyPermisosEditar">
									<tr><td colspan="5" class="text-muted py-3">Selecciona un rol para ver los módulos disponibles.</td></tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnActualizarPerfil" class="btn bg-primary-subtle text-primary">
						Actualizar perfil
					</button>
				</div>
			</div>
		</div>
	</div>
</div>


@section Scripts{
	<script src="~/js/modules/seguridad/perfiles/perfil-index.js" asp-append-version="true"></script>
	<script src="~/js/modules/seguridad/perfiles/perfil-form.js" asp-append-version="true"></script>
}