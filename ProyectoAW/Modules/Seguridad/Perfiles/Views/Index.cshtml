@{
    ViewData["Title"] = "Prueba de perfiles";
}

<h1>Prueba de perfiles</h1>

<p>Formulario simple para probar los endpoints de perfiles. La API requiere un token JWT de administrador.</p>

<div>
    <label for="token">Token Bearer</label><br />
    <textarea id="token" rows="4" cols="100" placeholder="Pega aquí el token recibido desde /api/auth/login"></textarea>
</div>

<hr />

<div>
    <h2>Datos del perfil</h2>
    <label for="perfilId">ID del perfil (solo para actualizar)</label><br />
    <input id="perfilId" type="number" min="1" />
    <button type="button" id="cargarPerfil">Obtener perfil</button><br /><br />

    <label for="nombrePerfil">Nombre del perfil</label><br />
    <input id="nombrePerfil" type="text" maxlength="100" /><br /><br />

    <label for="idRol">ID del rol</label><br />
    <input id="idRol" type="number" min="1" /><br />
    <button type="button" id="cargarModulos">Cargar módulos del rol</button>
</div>

<div>
    <h2>Permisos por módulo</h2>
    <div id="modulos">Ingresa un ID de rol y carga sus módulos.</div>
</div>

<p>
    <button type="button" id="crear">Crear perfil</button>
    <button type="button" id="actualizar">Actualizar perfil</button>
</p>

<h2>Respuesta</h2>
<pre id="respuesta">Listo.</pre>

<script>
    const apiBase = "/api/perfiles";
    const respuesta = document.getElementById("respuesta");

    function headersJson() {
        const headers = { "Content-Type": "application/json" };
        const token = document.getElementById("token").value.trim();
        if (token) headers.Authorization = `Bearer ${token}`;
        return headers;
    }

    async function llamarApi(url, options = {}) {
        const response = await fetch(url, {
            ...options,
            headers: { ...headersJson(), ...(options.headers || {}) }
        });
        const text = await response.text();
        let data;
        try { data = text ? JSON.parse(text) : null; }
        catch { data = text; }

        respuesta.textContent = `HTTP ${response.status}\n` +
            (typeof data === "string" ? data : JSON.stringify(data, null, 2));

        if (!response.ok) throw new Error(`La API respondió HTTP ${response.status}.`);
        return data;
    }

    function valor(objeto, nombre) {
        return objeto?.[nombre] ?? objeto?.[nombre.charAt(0).toUpperCase() + nombre.slice(1)];
    }

    document.getElementById("cargarModulos").addEventListener("click", async () => {
        const idRol = Number(document.getElementById("idRol").value);
        if (!idRol) {
            respuesta.textContent = "Ingresa un ID de rol válido.";
            return;
        }

        try {
            const result = await llamarApi(`${apiBase}/modulos?idRol=${encodeURIComponent(idRol)}`);
            const modulos = result?.datos ?? result?.Datos ?? [];
            const contenedor = document.getElementById("modulos");
            contenedor.replaceChildren();

            for (const modulo of modulos) {
                const fieldset = document.createElement("fieldset");
                const legend = document.createElement("legend");
                legend.textContent = modulo;
                fieldset.appendChild(legend);

                for (const accion of ["Ver", "Crear", "Actualizar", "Eliminar"]) {
                    const label = document.createElement("label");
                    const checkbox = document.createElement("input");
                    checkbox.type = "checkbox";
                    checkbox.dataset.modulo = modulo;
                    checkbox.dataset.accion = accion;
                    label.append(checkbox, ` ${accion} `);
                    fieldset.appendChild(label);
                }

                contenedor.appendChild(fieldset);
            }

            if (modulos.length === 0) contenedor.textContent = "El rol no tiene módulos disponibles.";
        } catch (error) {
            console.error(error);
        }
    });

    document.getElementById("cargarPerfil").addEventListener("click", async () => {
        const id = Number(document.getElementById("perfilId").value);
        if (!id) {
            respuesta.textContent = "Ingresa el ID del perfil que deseas consultar.";
            return;
        }

        try {
            const result = await llamarApi(`${apiBase}/${id}`);
            const perfil = valor(result, "datos");
            if (!perfil) {
                respuesta.textContent = "La respuesta no contiene los datos del perfil.";
                return;
            }

            const idRol = valor(perfil, "idRol");
            document.getElementById("nombrePerfil").value = valor(perfil, "nombrePerfil") ?? "";
            document.getElementById("idRol").value = idRol ?? "";

            const modulosResult = await llamarApi(
                `${apiBase}/modulos?idRol=${encodeURIComponent(idRol)}`);
            const modulos = valor(modulosResult, "datos") ?? [];
            const contenedor = document.getElementById("modulos");
            contenedor.replaceChildren();

            for (const modulo of modulos) {
                const fieldset = document.createElement("fieldset");
                const legend = document.createElement("legend");
                legend.textContent = modulo;
                fieldset.appendChild(legend);

                for (const accion of ["Ver", "Crear", "Actualizar", "Eliminar"]) {
                    const label = document.createElement("label");
                    const checkbox = document.createElement("input");
                    checkbox.type = "checkbox";
                    checkbox.dataset.modulo = modulo;
                    checkbox.dataset.accion = accion;
                    label.append(checkbox, ` ${accion} `);
                    fieldset.appendChild(label);
                }
                contenedor.appendChild(fieldset);
            }

            const permisos = valor(perfil, "permisos") ?? [];
            for (const permiso of permisos) {
                const modulo = valor(permiso, "modulo");
                for (const accion of ["Ver", "Crear", "Actualizar", "Eliminar"]) {
                    const checkbox = document.querySelector(
                        `#modulos input[data-modulo="${modulo}"][data-accion="${accion}"]`);
                    if (checkbox) checkbox.checked = Boolean(valor(permiso, accion.toLowerCase()));
                }
            }

            if (modulos.length === 0) contenedor.textContent = "El rol no tiene módulos disponibles.";
        } catch (error) {
            console.error(error);
        }
    });

    function obtenerPayload() {
        const nombrePerfil = document.getElementById("nombrePerfil").value.trim();
        const idRol = Number(document.getElementById("idRol").value);
        const permisosPorModulo = new Map();

        document.querySelectorAll("#modulos input[type=checkbox]").forEach(checkbox => {
            const modulo = checkbox.dataset.modulo;
            if (!permisosPorModulo.has(modulo)) {
                permisosPorModulo.set(modulo, {
                    Modulo: modulo,
                    Ver: false,
                    Crear: false,
                    Actualizar: false,
                    Eliminar: false
                });
            }
            permisosPorModulo.get(modulo)[checkbox.dataset.accion] = checkbox.checked;
        });

        return {
            NombrePerfil: nombrePerfil,
            IdRol: idRol,
            Permisos: Array.from(permisosPorModulo.values())
        };
    }

    document.getElementById("crear").addEventListener("click", async () => {
        try {
            await llamarApi(apiBase, { method: "POST", body: JSON.stringify(obtenerPayload()) });
        } catch (error) {
            console.error(error);
        }
    });

    document.getElementById("actualizar").addEventListener("click", async () => {
        const id = Number(document.getElementById("perfilId").value);
        if (!id) {
            respuesta.textContent = "Ingresa el ID del perfil que deseas actualizar.";
            return;
        }

        try {
            await llamarApi(`${apiBase}/${id}`, {
                method: "PUT",
                body: JSON.stringify(obtenerPayload())
            });
        } catch (error) {
            console.error(error);
        }
    });
</script>
