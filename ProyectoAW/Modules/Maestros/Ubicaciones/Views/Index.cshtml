@{
	ViewData["Title"] = "Ubicaciones";
	ViewData["Description"] = "Organiza y crea ubicaciones para sus almacenes.";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-body py-3">
	<div class="row align-items-center">
		<div class="col-12">
			<div class="d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="card-title">Ubicaciones</h4>
					<p>Organice sus ubicaciones</p>
				</div>
				<button class="btn btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalCrearUbicacion">
					<i class="ti ti-plus fs-5"></i>
					Nueva ubicación
				</button>
			</div>
		</div>
	</div>	
</div>

<div class="card card-body">
	<div class="row mb-3">
		<div class="col">
			<label class="form-label">Ubicación</label>
			<div class="input-group">
				<input id="txtBuscarUbicacion" class="form-control" placeholder="Buscar ubicación..." />
				<button id="btnLimpiarFiltros" class="btn btn-outline-secondary"><i class="ti ti-eraser fs-5"></i></button>
			</div>
			
		</div>
		<div class="col">
			<label class="form-label">Estado</label>
			<select id="slcEstado" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Activo</option>
				<option value="2">Inactivo</option>
			</select>
		</div>
	</div>

	<div id="tblUbicaciones" class="table-striped">

	</div>
</div>


<!-- MODAL CREAR UBICACION -->
<div class="modal fade" id="modalCrearUbicacion" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Crear ubicación
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div class="row">
					<!-- Código -->
					<div class="col-md-6 mb-3">
						<label for="txtCodigo" class="form-label">
							Código <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtCodigo" class="form-control" placeholder="Ej: UBI_001" maxlength="50" required />
					</div>

					<!-- Nombre -->
					<div class="col-md-6 mb-3">
						<label for="txtNombre" class="form-label">
							Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNombre" class="form-control" placeholder="Ej: Rack superior" maxlength="50" required />
					</div>

					<!-- Almacen -->
					<div class="col-12 mb-3">
						<label class="form-label">
							Almacen <span class="text-danger">*</span>
							</label>
						<select id="slcAlmacen" class="form-select">
							<option value="0">Ninguno</option>
							<option value="1">ALM-PRINCIPAL</option>
						</select>
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivo" class="form-check-input" checked/>
							<label for="chkActivo" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si la ubicación estará habilitado para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnGuardarUbicacion" class="btn bg-primary-subtle text-primary">
						Guardar ubicación
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- MODAL EDITAR UBICACION -->
<div class="modal fade" id="modalEditarUbicacion" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Editar ubicacion
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<input type="hidden" id="txtIdUbicacionEditar"/>
				<div class="row">
					<!-- Código -->
					<div class="col-md-6 mb-3">
						<label for="txtCodigoEditar" class="form-label">
							Código
						</label>
						<input type="text" id="txtCodigoEditar" class="form-control" maxlength="50" disabled />
					</div>

					<!-- Nombre -->
					<div class="col-md-6 mb-3">
						<label for="txtNombreEditar" class="form-label">
							Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNombreEditar" class="form-control" maxlength="50" required />
					</div>

					<!-- Almacen -->
					<div class="col-12 mb-3">
						<label class="form-label">
							Almacen <span class="text-danger">*</span>
							</label>
						<select id="slcAlmacen" class="form-select">
							<option value="0">Ninguno</option>
							<option value="1">ALM-PRINCIPAL</option>
						</select>
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivoEditar" class="form-check-input" checked />
							<label for="chkActivoEditar" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si la ubicación estará habilitado para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnActualizarUbicacion" class="btn bg-primary-subtle text-primary">
						Actualizar ubicación
					</button>
				</div>
			</div>
		</div>
	</div>
</div>


@section Scripts{
	<script src="~/js/modules/maestros/ubicaciones/ubicacion-index.js" asp-append-version="true"></script>
}