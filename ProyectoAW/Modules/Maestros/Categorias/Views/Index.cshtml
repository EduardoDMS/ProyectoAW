@{
    ViewData["Title"] = "Categorías";
    ViewData["Description"] = "Organiza y crea categorías para los productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-body py-3">
	<div class="row align-items-center">
		<div class="col-12">
			<div class="d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="card-title">Categorías</h4>
					<p>Organiza y crea categorías para los productos</p>
				</div>
				<button class="btn btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalCrearCategoria">
					<i class="ti ti-plus fs-5"></i>
					Nueva categoría
				</button>
			</div>
		</div>
	</div>
</div>

<div class="card card-body">
	<div class="row mb-3">
		<div class="col">
			<label class="form-label">Categoría</label>
			<div class="input-group">
				<input id="txtBuscarCategoria" class="form-control" placeholder="Buscar categoría..." />
				<button id="btnLimpiarFiltros" class="btn btn-outline-secondary"><i class="ti ti-eraser fs-5"></i></button>
			</div>

		</div>
		<div class="col">
			<label class="form-label">Estado</label>
			<select id="slcEstado" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Activo</option>
				<option value="2">Inactivo</option>
			</select>
		</div>
	</div>

	<div id="tblCategorias" class="table-striped">
	</div>
</div>


<!-- MODAL CREAR CATEGORIA -->
<div class="modal fade" id="modalCrearCategoria" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Crear categoría
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div class="row">			
					<!-- Nombre -->
					<div class="col-md-6 mb-3">
						<label for="txtNombre" class="form-label">
							Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNombre" class="form-control" placeholder="Ej: Cómputo" maxlength="50" required />
					</div>

					<!-- Descripción -->
					<div class="col-md-6 mb-3">
						<label for="txtDescripcion" class="form-label">
							Descripción <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtDescripcion" class="form-control" placeholder="Ej: Accesorios de computadora" maxlength="50" required />
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivo" class="form-check-input" checked />
							<label for="chkActivo" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si la categoría estará habilitada para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnGuardarCategoria" class="btn bg-primary-subtle text-primary">
						Guardar categoría
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- MODAL EDITAR CATEGORIA -->
<div class="modal fade" id="modalEditarCategoria" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Editar categoría
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<input type="hidden" id="txtIdCategoriaEditar" />
				<div class="row">
					<!-- Nombre -->
					<div class="col-md-6 mb-3">
						<label for="txtNombreEditar" class="form-label">
							Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNombreEditar" class="form-control" maxlength="50" required />
					</div>

					<!-- Descripción -->
					<div class="col-md-6 mb-3">
						<label for="txtDescripcionEditar" class="form-label">
							Descripción
						</label>
						<input type="text" id="txtDescripcionEditar" class="form-control" maxlength="50" required />
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivoEditar" class="form-check-input" checked />
							<label for="chkActivoEditar" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si la categoría estará habilitada para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnActualizarCategoria" class="btn bg-primary-subtle text-primary">
						Actualizar categoría
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts{
	<script src="~/js/modules/maestros/categorias/categoria-index.js"></script>
	<script src="~/js/modules/maestros/categorias/categoria-form.js"></script>
}