@{
	ViewData["Title"] = "Productos";
	ViewData["Description"] = "Organiza y crea productos para los inventarios";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-body py-3">
	<div class="row align-items-center">
		<div class="col-12">
			<div class="d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="card-title">Productos</h4>
					<p>Organiza y crea productos para los inventarios</p>
				</div>
				<button class="btn btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalCrearProducto">
					<i class="ti ti-plus fs-5"></i>
					Nuevo producto
				</button>
			</div>
		</div>
	</div>
</div>

<div class="card card-body">
	<div class="row mb-3">
		<div class="col">
			<label class="form-label">Producto</label>
			<div class="input-group">
				<input id="txtBuscarProducto" class="form-control" placeholder="Buscar producto..." />
				<button id="btnLimpiarFiltros" class="btn btn-outline-secondary"><i class="ti ti-eraser fs-5"></i></button>
			</div>
		</div>
		<div class="col">
			<label class="form-label">Estado</label>
			<select id="slcEstado" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Activo</option>
				<option value="2">Inactivo</option>
			</select>
		</div>
	</div>

	<div id="tblProductos" class="table-striped">
	</div>
</div>


<!-- MODAL CREAR PRODUCTO -->
<div class="modal fade" id="modalCrearProducto" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Crear producto
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div class="row">
					<!-- Código -->
					<div class="col-md-6 mb-3">
						<label for="txtCodigo" class="form-label">
							Código <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtCodigo" class="form-control" placeholder="Ej: TM-2556" maxlength="50" required />
					</div>

					<!-- Nombre -->
					<div class="col-md-6 mb-3">
						<label for="txtNombre" class="form-label">
							Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNombre" class="form-control" placeholder="Ej: Termo manual" maxlength="50" required />
					</div>

					<!-- Categoría -->
					<div class="col-md-6 mb-3">
						<label class="form-label">
							Categoría <span class="text-danger">*</span>
						</label>
						<select id="slcCategoria" class="form-select">
							<option value="0">Ninguna</option>
						</select>
					</div>

					<!-- Unidad de medida -->
					<div class="col-md-6 mb-3">
						<label class="form-label">
							Unidad de medida <span class="text-danger">*</span>
						</label>
						<select id="slcUnidadMedida" class="form-select">
							<option value="0">Ninguna</option>
						</select>
					</div>				

					<!-- Lote -->
					<div class="col-md-6 mb-3">
						<label for="txtNombre" class="form-label">
							Lote
						</label>
						<input type="text" id="txtLote" class="form-control" placeholder="Ej: LOT-0015" maxlength="50" />
					</div>

					<!-- Serie -->
					<div class="col-md-6 mb-3">
						<label for="txtNombre" class="form-label">
							Serie
						</label>
						<input type="text" id="txtSerie" class="form-control" placeholder="Ej: S-001" maxlength="50" />
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivo" class="form-check-input" checked />
							<label for="chkActivo" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si el producto estará habilitado para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnGuardarProducto" class="btn bg-primary-subtle text-primary">
						Guardar producto
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- MODAL EDITAR PRODUCTO -->
<div class="modal fade" id="modalEditarProducto" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Editar producto
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<input type="hidden" id="txtIdProductoEditar" />
				<div class="row">
					<!-- Código -->
					<div class="col-md-6 mb-3">
						<label for="txtCodigoEditar" class="form-label">
							Código
						</label>
						<input type="text" id="txtCodigoEditar" class="form-control" maxlength="50" disabled />
					</div>

					<!-- Nombre -->
					<div class="col-md-6 mb-3">
						<label for="txtNombreEditar" class="form-label">
							Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNombreEditar" class="form-control" maxlength="50" required />
					</div>

					<!-- Categoría -->
					<div class="col-md-6 mb-3">
						<label class="form-label">
							Categoría <span class="text-danger">*</span>
						</label>
						<select id="slcCategoriaEditar" class="form-select">
							<option value="0">Ninguna</option>
						</select>
					</div>

					<!-- Unidad de medida -->
					<div class="col-md-6 mb-3">
						<label class="form-label">
							Unidad de medida <span class="text-danger">*</span>
						</label>
						<select id="slcUnidadMedidaEditar" class="form-select">
							<option value="0">Ninguna</option>
						</select>
					</div>				

					<!-- Lote -->
					<div class="col-md-6 mb-3">
						<label for="txtNombre" class="form-label">
							Lote
						</label>
						<input type="text" id="txtLoteEditar" class="form-control" placeholder="Ej: LOT-0015" maxlength="50" />
					</div>

					<!-- Serie -->
					<div class="col-md-6 mb-3">
						<label for="txtNombre" class="form-label">
							Serie
						</label>
						<input type="text" id="txtSerieEditar" class="form-control" placeholder="Ej: S-001" maxlength="50" />
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivoEditar" class="form-check-input" checked />
							<label for="chkActivoEditar" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si el producto estará habilitado para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnActualizarProducto" class="btn bg-primary-subtle text-primary">
						Actualizar producto
					</button>
				</div>
			</div>
		</div>
	</div>
</div>


@section Scripts{
	<script src="~/js/modules/maestros/productos/producto-index.js" asp-append-version="true"></script>
	<script src="~/js/modules/maestros/productos/producto-form.js" asp-append-version="true"></script>
}