@{
	ViewData["Title"] = "Clientes";
	ViewData["Description"] = "Organiza y crea clientes para las guías";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-body py-3">
	<div class="row align-items-center">
		<div class="col-12">
			<div class="d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="card-title">Clientes</h4>
					<p>Organiza y crea clientes para las guías</p>
				</div>
				<button class="btn btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalCrearCliente">
					<i class="ti ti-plus fs-5"></i>
					Nuevo cliente
				</button>
			</div>
		</div>
	</div>
</div>

<div class="card card-body">
	<div class="row mb-3">
		<div class="col">
			<label class="form-label">Clientes</label>
			<div class="input-group">
				<input id="txtBuscarCliente" class="form-control" placeholder="Buscar cliente..." />
				<button id="btnLimpiarFiltros" class="btn btn-outline-secondary"><i class="ti ti-eraser fs-5"></i></button>
			</div>

		</div>
		<div class="col">
			<label class="form-label">Estado</label>
			<select id="slcEstado" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Activo</option>
				<option value="2">Inactivo</option>
			</select>
		</div>
	</div>

	<div id="tblClientes" class="table-striped">

	</div>
</div>

<!-- MODAL CREAR CLIENTE -->
<div class="modal fade" id="modalCrearCliente" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Crear cliente
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div class="row">
					<!-- Razón social/Nombre -->
					<div class="col-md-12 mb-3">
						<label for="txtRazonSocial" class="form-label">
							Razón social/Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtRazonSocial" class="form-control" placeholder="Ej: Soluciones SAC" maxlength="50" required />
					</div>

					<!-- Tipo documento -->
					<div class="col-md-6 mb-3">
						<label class="form-label">
							Tipo de documento <span class="text-danger">*</span>
						</label>
						<select id="slcTipoDocumento" class="form-select">
							<option value="0">Ninguna</option>
						</select>
					</div>

					<!-- Número documento -->
					<div class="col-md-6 mb-3">
						<label for="txtNumeroDocumento" class="form-label">
							Número de documento <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNumeroDocumento" class="form-control" placeholder="Ej: 20605899481" maxlength="50" required />
					</div>

					<!-- Correo -->
					<div class="col-md-6 mb-3">
						<label for="txtCorreo" class="form-label">
							Correo
						</label>
						<input type="text" id="txtCorreo" class="form-control" placeholder="Ej: soluciones@hotmail.com" maxlength="50" />
					</div>

					<!-- Teléfono -->
					<div class="col-md-6 mb-3">
						<label for="txtTelefono" class="form-label">
							Teléfono
						</label>
						<input type="text" id="txtTelefono" class="form-control" placeholder="Ej: 984 524 662" maxlength="50" />
					</div>

					<!-- Dirección -->
					<div class="col-md-6 mb-3">
						<label for="txtDireccion" class="form-label">
							Dirección
						</label>
						<input type="text" id="txtDireccion" class="form-control" placeholder="Ej: Av. Arequipa 1285" maxlength="50" />
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivo" class="form-check-input" checked />
							<label for="chkActivo" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si el cliente estará habilitado para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnGuardarCliente" class="btn bg-primary-subtle text-primary">
						Guardar cliente
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- MODAL EDITAR CLIENTE -->
<div class="modal fade" id="modalEditarCliente" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center">
				<h4 class="modal-title">
					Editar cliente
				</h4>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<div class="modal-body">
				<div class="row">
					<!-- Razón social/Nombre -->
					<div class="col-md-12 mb-3">
						<label for="txtRazonSocialEditar" class="form-label">
							Razón social/Nombre <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtRazonSocialEditar" class="form-control" maxlength="50" required />
					</div>

					<!-- Tipo documento -->
					<div class="col-md-6 mb-3">
						<label class="form-label">
							Tipo de documento <span class="text-danger">*</span>
						</label>
						<select id="slcTipoDocumentoEditar" class="form-select">
							<option value="0">Ninguna</option>
						</select>
					</div>

					<!-- Número documento -->
					<div class="col-md-6 mb-3">
						<label for="txtNumeroDocumentoEditar" class="form-label">
							Número de documento <span class="text-danger">*</span>
						</label>
						<input type="text" id="txtNumeroDocumentoEditar" class="form-control" maxlength="50" required />
					</div>

					<!-- Correo -->
					<div class="col-md-6 mb-3">
						<label for="txtCorreoEditar" class="form-label">
							Correo
						</label>
						<input type="text" id="txtCorreoEditar" class="form-control" maxlength="50" />
					</div>

					<!-- Teléfono -->
					<div class="col-md-6 mb-3">
						<label for="txtTelefonoEditar" class="form-label">
							Teléfono
						</label>
						<input type="text" id="txtTelefonoEditar" class="form-control" maxlength="50" />
					</div>

					<!-- Dirección -->
					<div class="col-md-6 mb-3">
						<label for="txtDireccionEditar" class="form-label">
							Dirección
						</label>
						<input type="text" id="txtDireccionEditar" class="form-control" maxlength="50" />
					</div>

					<!-- Estado -->
					<div class="col-12 mb-3">
						<div class="form-check form-switch">
							<input type="checkbox" id="chkActivoEditar" class="form-check-input" checked />
							<label for="chkActivoEditar" class="form-check-label">
								Activo
							</label>
						</div>
						<small class="text-muted">
							Indica si el cliente estará habilitado para su utilización
						</small>
					</div>
				</div>
			</div>

			<div class="modal-footer">
				<div>
					<button type="button" class="btn bg-danger-subtle text-danger" data-bs-dismiss="modal" aria-label="Close">
						Cancelar
					</button>
					<button type="button" id="btnActualizarCliente" class="btn bg-primary-subtle text-primary">
						Actualizar cliente
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts{
	<script src="~/js/modules/maestros/clientes/clientes-index.js"></script>
	<script src="~/js/modules/maestros/clientes/clientes-form.js"></script>
}