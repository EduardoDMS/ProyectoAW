@{
	ViewData["Title"] = "Motivos guía";
	ViewData["Description"] = "Organiza y crea motivos para las guías de remisión";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-body py-3">
	<div class="row align-items-center">
		<div class="col-12">
			<div class="d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="card-title">Motivos</h4>
					<p>Organiza y crea motivos para las guías de remisión</p>
				</div>
				<button class="btn btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalCrearMotivo">
					<i class="ti ti-plus fs-5"></i>
					Nuevo motivo
				</button>
			</div>
		</div>
	</div>
</div>

<div class="card card-body">
	<div class="row mb-3">
		<div class="col-md-6">
			<label class="form-label">Motivo</label>
			<div class="input-group">
				<input id="txtBuscarMotivoGuia" class="form-control" placeholder="Buscar motivo..." />
				<button id="btnLimpiarFiltros" class="btn btn-outline-secondary"><i class="ti ti-eraser fs-5"></i></button>
			</div>

		</div>
		<div class="col-md-3">
			<label class="form-label">Operación</label>
			<select id="slcOperacion" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Entrada</option>
				<option value="2">Salida</option>
			</select>
		</div>
		<div class="col-md-3">
			<label class="form-label">Estado</label>
			<select id="slcEstado" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Activo</option>
				<option value="2">Inactivo</option>
			</select>
		</div>
	</div>

	<div id="tblMotivosGuia" class="table-striped">
	</div>
</div>

@section Scripts{
	<script src="~/js/modules/maestros/motivosGuia/motivoGuia-index.js" asp-append-version="true"></script>
	<script src="~/js/modules/maestros/motivosGuia/motivoGuia-form.js" asp-append-version="true"></script>
}