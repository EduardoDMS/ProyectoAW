@{
	ViewData["Title"] = "Guías";
	ViewData["Description"] = "Registra guías de remisión para el ingreso y salida de productos en tus almacenes";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card card-body py-3">
	<div class="row align-items-center">
		<div class="col-12">
			<div class="d-sm-flex align-items-center justify-content-between">
				<div>
					<h4 class="card-title">Guías</h4>
					<p>Registra guías de remisión para el ingreso y salida de productos en tus almacenes</p>
				</div>
				<button class="btn btn-success d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#modalCrearProducto">
					<i class="ti ti-plus fs-5"></i>
					Nueva guía
				</button>
			</div>
		</div>
	</div>
</div>

<div class="card card-body">
	<div class="row mb-3">
		<div class="col-md-6">
			<label class="form-label">Guía</label>
			<div class="input-group">
				<input id="txtBuscarProducto" class="form-control" placeholder="Buscar guía..." />
				<button id="btnLimpiarFiltros" class="btn btn-outline-secondary"><i class="ti ti-eraser fs-5"></i></button>
			</div>

		</div>

		<div class="col-md-3">
			<label class="form-label">Operación</label>
			<select id="slcOperacion" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Entrada</option>
				<option value="2">Salida</option>
				<option value="3">Translado</option>
			</select>
		</div>

		<div class="col-md-3">
			<label class="form-label">Estado</label>
			<select id="slcEstado" class="form-select">
				<option value="0">Todos</option>
				<option value="1">Pendiente</option>
				<option value="2">En proceso</option>
				<option value="3">Atendida</option>
				<option value="4">Cancelada</option>
			</select>
		</div>
	</div>

	<div id="tblGuias" class="table-striped">

	</div>
</div>

@section Scripts{
	<script src="~/js/modules/guias/guia-index.js" asp-append-version="true"></script>
	<script src="~/js/modules/guias/guia-form.js" asp-append-version="true"></script>
}